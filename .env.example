# ── LLM (TrueFoundry / OpenAI-compatible) ─────────────────────────────────────
TF_BASE_URL=https://truefoundry.your-org.com/api/llm/api/inference/openai/
TF_API_KEY=your-api-key-here
TF_MODEL=internal-bedrock/sonnet-46

# ── Snowflake ──────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.region.snowflakecomputing.com
SNOWFLAKE_HOST=your-account.region.snowflakecomputing.com
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=your-schema
SNOWFLAKE_ROLE=your-role

# ── Pipeline test mode ─────────────────────────────────────────────────────────
# STORY_TEST_MODE=1   → process only TEST_VISUAL_TYPE (fast dev iteration)
# STORY_TEST_MODE=0   → process all visual types (full production run)
STORY_TEST_MODE=1
STORY_TEST_VISUAL_TYPE=cardVisual
STORY_TEST_LIMIT=0
