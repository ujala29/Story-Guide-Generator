	partition pac_opp_patient_view = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(DB_HOST_STRING,WAREHOUSE,[Role=ROLE]),
				    DAP_Database = Source{[Name=L5_DB_NAME,Kind="Database"]}[Data],
				    L5_PAC_Schema = DAP_Database{[Name=SCHEMA_NAME,Kind="Schema"]}[Data],
				    PAC_OPP_PATIENT_VIEW_View = L5_PAC_Schema{[Name="INPATIENT_PAC_V4_VIEW",Kind="View"]}[Data],
				    #"Lowercased Text" = Table.TransformColumnNames(PAC_OPP_PATIENT_VIEW_View, Text.Lower),
				    #"Removed Duplicates" = Table.Distinct(#"Lowercased Text", {"join_key"})
				in
				    #"Removed Duplicates"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

