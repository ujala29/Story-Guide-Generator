table ALL_DAX_PAC
	lineageTag: 9f819040-7ffe-4e82-9309-cb1bf16ee114

	measure 'Overall PAC cost' = sum(pac_view[pac_visit_amount]) +0
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 65757c0a-1d51-4b75-869a-159d8bd7b2f3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'IP Discharges' = CALCULATE(count(pac_opp_patient_view[visit_id])) +0
		formatString: #,0
		lineageTag: 684bdc91-320b-4a4c-a2f5-ce5b7d43ff77

	measure 'IP to Pac Discharges' = CALCULATE(DISTINCTCOUNT(pac_view[join_key])) +0
		formatString: #,0
		lineageTag: 862c6cd9-ad96-4db8-9845-49779483e896

	measure 'Readmission % IP Admits' = ```
			
			VAR TotalReadmissions = 
			    CALCULATE(
			        COUNTROWS(pac_opp_patient_view),
			        pac_opp_patient_view[readmission_flag] = TRUE
			    ) 
			
			VAR TotalIndexVisits = 
			    CALCULATE(
			        COUNTROWS(pac_opp_patient_view),
			        pac_opp_patient_view[readmission_index_visit_flag] = TRUE
			    )
			
			RETURN
			DIVIDE(TotalReadmissions, TotalIndexVisits)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 4bdf5b9b-cd5a-47b7-ba8b-4477eb2ddf7b

	measure 'PAC to IP readmission %' = ```
			
			VAR TotalReadmissions = 
			    CALCULATE(
			        DISTINCTCOUNT(pac_view[join_key]),
			        pac_view[readmission_flag] = "true"
			    ) 
			
			VAR TotalIndexVisits = 
			    CALCULATE(
			        DISTINCTCOUNT(pac_view[join_key]),
			        pac_view[readmission_index_visit_flag] = "true"
			    )
			
			RETURN
			CALCULATE(DIVIDE(TotalReadmissions, TotalIndexVisits), KEEPFILTERS(pac_view[last_transfer] = "true"))
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 527c7194-b194-40f9-bc7f-a920dc358f2e

	measure 'Hospice PMPM' =
			
			CALCULATE(DIVIDE(sum(pac_view[pac_visit_amount]),sum(attribution[member_count])),
			pac_view[pac_visit_type] = "Hospice")
		lineageTag: 73d8edd9-ce1b-41d0-962b-1fd547d291a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PAC PMPM' = DIVIDE(sum(pac_view[pac_visit_amount]),sum(attribution[member_count]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c10b3b5e-7522-40e6-a4a9-11b3b886812d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Cost/Admit = DIVIDE(sum(pac_view[pac_visit_amount]), COUNTROWS(pac_view))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6e70d46d-80a8-4abb-bde6-a4df81203d77

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Blank DAX' = ""
		lineageTag: 83479483-74bc-414b-b50e-791e45c8dee1

	measure 'Avg LOS' = ```
			CALCULATE(AVERAGE(pac_view[pac_length_of_stay]),KEEPFILTERS(pac_view[pac_visit_type] <> "Home Health")) +0 
			```
		formatString: 0
		lineageTag: 5afa1453-7ce4-452e-8e6c-da48d9ac997a

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% IP discharges to PAC' = DIVIDE([IP to Pac Discharges],[IP Discharges])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: dc357276-67c1-4f8f-9624-6f67e2090ad5

	measure Utilization =
			
			VAR Num =
			    CALCULATE(
			        count(pac_view[join_key])
			    )
			VAR Denom = SUM(attribution[member_count])
			RETURN
			DIVIDE(Num, Denom) * 12000
		formatString: #,0
		lineageTag: b2578648-acf9-4fdc-bbed-91cd7da4cc15

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Formatted % IP discharges to PAC' =
			
			VAR x = [% IP discharges to PAC]
			RETURN FORMAT(x, "0.0%")
		lineageTag: a647c143-c6c4-4de3-bc41-a77ccd5b1486

	measure '% IP discharges to PAC MoM' =
			
			var pm = CALCULATE([% IP discharges to PAC], PREVIOUSMONTH('date'[month_of_date]))
			RETURN
			DIVIDE([% IP discharges to PAC] - pm, pm)
		formatString: 0%;-0%;0%
		lineageTag: dd819955-5184-4195-be0a-90f701107f1c

	measure '% IP discharges to PAC MoM Card' =
			
			VAR pm = CALCULATE([% IP discharges to PAC], PREVIOUSMONTH('date'[month_of_date]))
			VAR mom = DIVIDE([% IP discharges to PAC] - pm, pm)
			RETURN
			IF(
			    ISBLANK(pm),
			    "",
			    SWITCH(
			        TRUE(),
			        mom > 0, UNICHAR(9650) & " " & FORMAT(mom, "0.0%") & " from LM",
			        mom < 0, UNICHAR(9660) & " " & FORMAT(ABS(mom), "0.0%") & " from LM",
			        "0.0%"
			    )
			)
		lineageTag: 3928f1de-a940-4f98-b635-1d62d8d381fe

	measure '% IP discharges to PAC MoM color' =
			
			var a = [% IP discharges to PAC MoM]
			return
			SWITCH(TRUE(),
				a> 0, 2,
				a< 0, 1)
		formatString: 0
		lineageTag: 4d4b50de-4a48-45a7-9348-ba26afe42827

