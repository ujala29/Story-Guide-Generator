	measure increase_RAF_impact_cohort =
			
			var latest_month = CALCULATE(max(cohort[month_of_measurement]), ALL('DATE'))
			var doc = CALCULATE([Documented risk], risk_core[month_of_measurement]= latest_month, ALL('DATE'))
			var a = [RAF_impact_cohort] + doc
			var b = doc
			RETURN
			format( DIVIDE((a-b),b)+0, "0.0%") & " increase in the documented RAF Score"
