	measure RAF_impact_cohort = ```
			
			var latest_month = CALCULATE(max(cohort[month_of_measurement]), ALL('DATE'))
			var a = CALCULATE(SUM(cohort[risk_value]), cohort[month_of_measurement] = latest_month, ALL('DATE'), cohort[risk_documentation_flag] in {"Undoumented","Suspected"})
			var b = CALCULATE(sum(risk_core[patient_count]),KEEPFILTERS(risk_core[risk_documentation_flag]="Documented"), risk_core[month_of_measurement] = latest_month, ALL('DATE'))
			
			return 
			
			DIVIDE(a,b)
