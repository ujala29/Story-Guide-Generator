	measure 'Info text risk LY' = ```
			
			VAR MinMonthLY = CALCULATE ( MIN ( 'date'[month_of_date] ), SAMEPERIODLASTYEAR ( 'date'[month_of_date] )) 
			
			VAR MaxMonthLY = CALCULATE ( MAX ( 'date'[month_of_date] ), SAMEPERIODLASTYEAR ( 'date'[month_of_date] ) ) 
			
			VAR LY = YEAR ( MinMonthLY ) 
			
			VAR MinMonthCY = MIN ( attribution[month_of_date] ) 
			
			VAR MaxMonthCY = MAX ( attribution[month_of_date]) 
			
			VAR CY = YEAR ( MinMonthCY ) 
			
			VAR MinMonthCY_Text = FORMAT ( MinMonthCY, "MMM" ) 
			
			VAR MaxMonthCY_Text = FORMAT ( MaxMonthCY, "MMM" ) 
			
			VAR MinMonthLY_Text = FORMAT ( MinMonthLY, "MMM" ) 
			
			VAR MaxMonthLY_Text = FORMAT ( MaxMonthLY, "MMM" ) 
			
			RETURN 
			SWITCH(SELECTEDVALUE('measure'[period_mode]),"ytd",
			    "Data for " & MinMonthCY_Text & " " & CY &
			    " (YTD) is being compared with " & MinMonthLY_Text &
			    " " & LY & " (YTD)",
			    "rolling",
			    "Data for " & MinMonthCY_Text & " " & CY &
			    " (Rolling 12 months) is being compared with " & MinMonthLY_Text &
			    " " & LY & " (Rolling 12 months)",
			    "payment",
			    "Data for " & MinMonthCY_Text & " " & CY &
			    " (Payment) is being compared with " & MinMonthLY_Text &
			    " " & LY & " (Payment)"
			    )
			
			```
