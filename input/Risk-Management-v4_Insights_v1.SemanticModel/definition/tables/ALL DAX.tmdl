	measure 'Realizable RAF score' = ```
			
			var a = CALCULATE(SUM(cohort[risk_value]), KEEPFILTERS(cohort[risk_documentation_flag] in {"Undocumented","Suspected"}))
			var b = CALCULATE(SUM(risk_core[patient_count]),KEEPFILTERS(risk_core[risk_documentation_flag]="Documented"),KEEPFILTERS(risk_core[max_month_flag] = TRUE()))
			var c = CALCULATE([Documented risk],KEEPFILTERS(risk_core[max_month_flag] = TRUE()))
			var result = DIVIDE(a,b) + c
			return 
